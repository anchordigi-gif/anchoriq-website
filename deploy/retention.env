# Retention for anchoriq.io (proposed; owner to confirm). Read by retention.sh, run daily by the systemd timer.
# Demo requests and waitlist signups: deleted this many days after they were sent (12 months).
ENQUIRY_RETENTION_DAYS=365
# Website request logs (one file per day in ./logs, each holding client addresses): kept this many days.
LOG_RETENTION_DAYS=14
